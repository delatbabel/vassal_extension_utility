<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.vassalengine</groupId>
    <artifactId>extension-utility</artifactId>
    <version>1.0.12</version>
    <packaging>jar</packaging>

    <name>VASSAL Extension Utility</name>
    <description>Utility for moving components between VASSAL modules and extensions</description>
    <url>https://vassalengine.org</url>
    <inceptionYear>2025</inceptionYear>
    <licenses>
        <license>
            <name>GNU Lesser General Public License, version 2.1</name>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <main.class>org.vassalengine.extutil.Main</main.class>
        <!--
          Excluded unless -Dvassal.engine.jar=... is given (see the refresh-runner
          profile, which clears this). Without an engine the runner is left out and
          the application reports Refresh Counters as unavailable.
        -->
        <refresh.runner.exclude>org/vassalengine/extutil/refresh/RefreshRunner.java</refresh.runner.exclude>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.37</version>
        </dependency>
        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
            <version>11.4.3</version>
        </dependency>
    </dependencies>

    <!--
      The Refresh Counters runner links against VASSAL, which is not published to
      Maven Central, so it is built only on demand:

          ./mvnw package -Dvassal.engine.jar=/usr/share/vassal/lib/Vengine.jar

      `make jar` finds an installed engine and passes this for you. Without it the
      project still builds — the runner is simply left out, and the application
      reports Refresh Counters as unavailable rather than failing to start.

      Activation keys off the property being *set* rather than <file><exists>,
      because a POM property cannot drive profile activation: Maven interpolates
      the default rather than a -D override, so the profile switched on even when
      pointed at a jar that was not there.

      Only Vengine.jar is named, never lib/*: its manifest Class-Path pulls in the
      other jars relative to itself. A wildcard lets another jar's images/ folder
      shadow the engine's, and VASSAL then dies with "Icon Family eye not found"
      (its own source flags this as bug 9670).
    -->
    <profiles>
        <profile>
            <id>refresh-runner</id>
            <activation>
                <property>
                    <name>vassal.engine.jar</name>
                </property>
            </activation>
            <properties>
                <refresh.runner.exclude>nothing-to-exclude</refresh.runner.exclude>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.vassalengine</groupId>
                    <artifactId>vengine</artifactId>
                    <version>local</version>
                    <scope>system</scope>
                    <systemPath>${vassal.engine.jar}</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>


    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <excludes>
                        <exclude>${refresh.runner.exclude}</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
